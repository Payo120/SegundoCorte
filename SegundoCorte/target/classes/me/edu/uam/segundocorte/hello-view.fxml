<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="me.edu.uam.segundocorte.HelloController"
            prefWidth="980" prefHeight="620">

    <top>
        <VBox spacing="10" style="-fx-background-color: #f4f6f9; -fx-border-color: #dcdcdc; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="12" right="15" bottom="12" left="15"/>
            </padding>
            <Label text="Catálogo de Productos - Papelería Campus"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Buscar (código o nombre):"/>
                <TextField fx:id="txtBuscar" promptText="Ej. CUADERNO o T00" prefWidth="200"/>

                <Label text="Categoría:"/>
                <ComboBox fx:id="cmbFiltroCategoria" prefWidth="140"/>

                <CheckBox fx:id="chkSoloExistencias" text="Solo con existencias (stock &gt; 0)"/>

                <Button text="Buscar" onAction="#onBuscarClick" style="-fx-font-weight: bold;"/>
                <Button text="Limpiar filtros" onAction="#onLimpiarFiltrosClick"/>
                <Button text="Recargar" onAction="#onRecargarClick"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="12" right="10" bottom="12" left="15"/>
            </padding>

            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
                    <TableColumn fx:id="colPrecio" text="Precio (C$)" prefWidth="100"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                </columns>
            </TableView>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="lblContador" text="Registros visibles: 0" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblEstado" text="Listo"/>
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="10" prefWidth="290" style="-fx-background-color: #fafafa; -fx-border-color: #dcdcdc; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Datos del Producto" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <Label text="ID Producto (Autogenerado):"/>
            <TextField fx:id="txtId" editable="false" disable="true" promptText="Generado por PostgreSQL"/>

            <Label text="Código (1 a 10 caracteres):"/>
            <TextField fx:id="txtCodigo" promptText="Ej. P001"/>

            <Label text="Nombre (3 a 80 caracteres):"/>
            <TextField fx:id="txtNombre" promptText="Ej. Cuaderno universitario"/>

            <Label text="Categoría:"/>
            <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" promptText="Seleccione categoría"/>

            <Label text="Precio C$ (0.01 a 99999999.99):"/>
            <TextField fx:id="txtPrecio" promptText="Ej. 65.00"/>

            <Label text="Stock (Entero &gt;= 0):"/>
            <TextField fx:id="txtStock" promptText="Ej. 25"/>

            <Separator>
                <VBox.margin>
                    <Insets top="8" bottom="4"/>
                </VBox.margin>
            </Separator>

            <Button text="Nuevo / Limpiar formulario" onAction="#onNuevoLimpiarFormularioClick" maxWidth="Infinity"/>
            <Button text="Guardar (Crear nuevo)" onAction="#onGuardarClick" maxWidth="Infinity" style="-fx-font-weight: bold;"/>
            <Button text="Actualizar seleccionado" onAction="#onActualizarClick" maxWidth="Infinity"/>
            <Button text="Eliminar seleccionado" onAction="#onEliminarClick" maxWidth="Infinity"/>
        </VBox>
    </right>

</BorderPane>